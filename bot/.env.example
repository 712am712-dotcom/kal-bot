# ── Kalshi API ──────────────────────────────────────────────────────────────
# Create keys at: https://kalshi.com/account/api-keys
KALSHI_API_KEY=your_kalshi_api_key_id_uuid_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem   # RSA private key — never commit this file
KALSHI_DEMO=true                                   # true = use demo.kalshi.co, false = live trading

# ── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_MAX_TOKENS=1024

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Market Focus ─────────────────────────────────────────────────────────────
# "crypto" = BTC/ETH/SOL price prediction markets only (recommended)
# "all"    = scan all Kalshi markets (slower, less focused)
MARKET_FOCUS=crypto

# Crypto-specific thresholds (tighter than general because prices move fast)
CRYPTO_MIN_EDGE=0.06
CRYPTO_MIN_CONFIDENCE=0.62

# ── Risk Controls ────────────────────────────────────────────────────────────
MAX_BET_DOLLARS=25.0
DAILY_LOSS_LIMIT_DOLLARS=50.0
MIN_CONFIDENCE=0.70
MIN_EDGE=0.10
MIN_LIQUIDITY_DOLLARS=500.0
MAX_OPEN_POSITIONS=10

# ── Mode Toggles ─────────────────────────────────────────────────────────────
DEMO_MODE=true          # NEVER disable without reading order_manager.py first
RESEARCH_MODE=true      # true = scan+analyze only, no orders. false = live trading

# ── Scheduler ────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=30
VOLUME_FLOOR=150                        # Min market volume before calling Claude. Lower = more markets analyzed.
RESEARCH_SCAN_DELAY_SECONDS=1.5
RESEARCH_MAX_MARKETS=200

# ── Discord ────────────────────────────────────────────────────────────────────
# Create a webhook in Discord: Server Settings > Integrations > Webhooks > New Webhook
# Leave empty to disable Discord notifications entirely
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# Channel-specific webhooks — create one per channel in Discord Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_TRADES=
DISCORD_WEBHOOK_ANALYSIS=
DISCORD_WEBHOOK_SUMMARY=
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_INTELLIGENCE=

# Bot token — required for pinning messages and managing Discord channels programmatically.
# Create a bot at discord.com/developers, enable Message Content Intent, invite it to your server.
DISCORD_BOT_TOKEN=

# ── External Data APIs ────────────────────────────────────────────────────────
# Finnhub — free tier, sign up at finnhub.io — used for news + economic calendar
FINNHUB_API_KEY=

# Alpha Vantage — free tier (25 calls/day), sign up at alphavantage.co
# Used for gold (GLD), oil (USO), dollar index (UUP) in market open/close posts
ALPHA_VANTAGE_KEY=

# FRED (Federal Reserve Economic Data) — free, register at fred.stlouisfed.org/docs/api/api_key.html
# Used for bond yields, Fed Funds Rate, CPI, unemployment, yield curve, HY spreads
# Critical for economic calendar and market close bond analysis — highly recommended
FRED_API_KEY=

# Binance — no API key needed for public candle endpoints
# Leave blank — Kal uses the public REST API automatically
BINANCE_API_KEY=

# ── Intelligence Scanner ──────────────────────────────────────────────────────
# How often to scan markets for notable changes and post to #intelligence
INTELLIGENCE_SCAN_INTERVAL=30

# ── Cost Controls ────────────────────────────────────────────────────────────
# Which coins to analyze. Start with BTC only to cut Claude calls 3x.
# Add ETH,SOL back once API credits are healthy.
ACTIVE_COINS=BTC

# Daily API spend limits — Kal tracks cost per call and enforces these.
# WARNING level: sends a Discord alert to #alerts when daily spend crosses this.
DAILY_COST_WARNING_DOLLARS=1.00

# HARD LIMIT: Kal switches to the fallback model for the rest of the day at this level.
# Resets at midnight ET. Set to 0 to disable (not recommended).
DAILY_COST_LIMIT_DOLLARS=1.50

# Fallback model — used after the hard limit is hit. Haiku is ~20x cheaper than Opus.
# Handles simple YES/NO decisions well enough to keep trading while saving money.
CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001

# ── Email Morning Brief ────────────────────────────────────────────────────────
# Comma-separated list of newsletter sender addresses.
# Kal reads ALL of them every morning and synthesizes into one brief (one Claude call).
# Leave empty to disable the morning brief feature.
# Original 5 newsletters + Morning Brew + Daily Pnut + 13 Axios addresses + @axios.com domain wildcard
# The @axios.com entry at the end catches any Axios address not listed explicitly (domain wildcard)
NEWSLETTER_EMAILS=news@execsum.co,cryptosum@mail.beehiiv.com,dailyfriday@mail.beehiiv.com,tyler@mail.bigdeskenergy.com,theaireport@mail.beehiiv.com,crew@morningbrew.com,dailypnut@mail.beehiiv.com,newsletters@axios.com,2028@axios.com,closer@axios.com,finishline@axios.com,energy@axios.com,defense@axios.com,hill@axios.com,mike@axios.com,vitals@axios.com,tylers@axios.com,dan@axios.com,communicators@axios.com,mobility@axios.com,@axios.com

# Axios breaking news: Kal also checks for Axios alert emails every 30 minutes
# and evaluates each one for market implications (separate from the morning brief).
# Max 5 Discord posts/day. One Claude call per alert.

# IMPORTANT: Subscribe KAL_EMAIL_ADDRESS to all newsletters above.
# Each newsletter must be subscribed individually at the sender's website.

# ── IMAP credentials (primary -- works with Gmail, Outlook, Yahoo, any provider)
# Recommended for Railway / headless servers -- no browser required, 24/7.
# Server is auto-detected from the email domain (@gmail.com, @outlook.com, etc.)
#
# Gmail setup (App Password required -- NOT your regular Gmail password):
#   1. Go to myaccount.google.com -> Security -> 2-Step Verification -> Enable
#   2. Go to myaccount.google.com -> Security -> App Passwords
#   3. Select "Mail" and "Windows Computer" -> Generate
#   4. Copy the 16-char password (looks like: xxxx xxxx xxxx xxxx)
#   5. Paste it as KAL_EMAIL_PASSWORD below
#   6. In Gmail settings -> See all settings -> Forwarding and POP/IMAP -> Enable IMAP
#
# Outlook setup (use your regular account password):
#   KAL_EMAIL_ADDRESS=kalpredicts@outlook.com
#   KAL_EMAIL_PASSWORD=your_outlook_password
#
KAL_EMAIL_ADDRESS=kalpredictslp@gmail.com
KAL_EMAIL_PASSWORD=

# ── Fallback notifications ────────────────────────────────────────────────────
# When Discord is unavailable, Kal emails this address instead.
# Uses KAL_EMAIL_ADDRESS + KAL_EMAIL_PASSWORD (Gmail SMTP) to send.
# Set to your personal email so you never miss a Kal alert.
KAL_OWNER_EMAIL=your@email.com

# ── Gmail OAuth2 (local development only -- requires browser on first run) ────
# Path to Google Cloud OAuth2 credentials JSON file
# Download from console.cloud.google.com -> APIs & Services -> Credentials
GMAIL_CREDENTIALS_PATH=./gmail_credentials.json

# Path where the OAuth2 token is saved after first-run authorization
# This file is auto-created on first run -- do not commit it
GMAIL_TOKEN_PATH=./gmail_token.json
